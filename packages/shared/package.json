{
  "name": "@alpha-kanban/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./documentSettings": {
      "types": "./src/documentSettings.d.mts",
      "import": "./src/documentSettings.mjs"
    },
    "./documentPresentation": {
      "types": "./src/documentPresentation.d.mts",
      "import": "./src/documentPresentation.mjs"
    },
    "./documentMigration": {
      "types": "./src/documentMigration.d.mts",
      "import": "./src/documentMigration.mjs"
    },
    "./documentReferences": {
      "types": "./src/documentReferences.d.mts",
      "import": "./src/documentReferences.mjs"
    },
    "./documentMetadata": {
      "types": "./dist/documentMetadata.d.ts",
      "import": "./dist/documentMetadata.js"
    },
    "./ticketMarkdown": {
      "types": "./dist/ticketMarkdown.d.ts",
      "import": "./dist/ticketMarkdown.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "import": "./dist/documents.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "micromark-util-decode-string": "2.0.1",
    "zod": "^4.4.3"
  }
}
