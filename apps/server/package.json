{
  "name": "@alpha-kanban/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "pnpm --filter @alpha-kanban/shared build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "pnpm --filter @alpha-kanban/shared build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @alpha-kanban/shared build && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@alpha-kanban/shared": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.22.4"
  }
}
