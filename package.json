{
  "name": "alpha-kanban",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:browser": "pnpm dev",
    "build:browser": "pnpm build",
    "preview:browser": "pnpm preview",
    "build:browser:recovery": "node scripts/build-browser-rescue.mjs recovery",
    "build:browser:retired": "node scripts/build-browser-rescue.mjs retired",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "test:tours": "node scripts/tours-smoke.mjs",
    "dev": "node scripts/package-browser-assets.mjs && pnpm --filter @alpha-kanban/web dev",
    "build": "node scripts/package-browser-assets.mjs && pnpm --filter @alpha-kanban/shared build && pnpm --filter @alpha-kanban/web build",
    "preview": "pnpm --filter @alpha-kanban/web preview",
    "typecheck": "pnpm --filter @alpha-kanban/web typecheck",
    "install:skill": "node scripts/install-implementation-ledger-skill.mjs",
    "ticket-md": "node scripts/ticket-md.mjs",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "fflate": "^0.8.3",
    "playwright": "1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
