{
  "name": "alpha-kanban",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:browser": "pnpm dev",
    "build:browser": "pnpm build",
    "preview:browser": "pnpm preview",
    "build:browser:recovery": "node scripts/build-browser-rescue.mjs recovery",
    "build:browser:retired": "node scripts/build-browser-rescue.mjs retired",
    "test:pwa": "node scripts/pwa-smoke.mjs",
    "test:pwa-entry": "node scripts/pwa-entry-smoke.mjs",
    "test:skill-release": "node scripts/skill-release-smoke.mjs",
    "test:tours": "node scripts/tours-smoke.mjs",
    "test:skill-tour": "node scripts/skill-tour-smoke.mjs",
    "test:skill-notice": "node scripts/skill-notice-smoke.mjs",
    "dev": "node scripts/package-browser-assets.mjs && pnpm --filter @alpha-kanban/web dev",
    "build": "node scripts/package-browser-assets.mjs && pnpm --filter @alpha-kanban/shared build && pnpm --filter @alpha-kanban/web build && node scripts/check-browser-release.mjs",
    "check:release": "node scripts/check-browser-release.mjs",
    "test:channels": "node --test scripts/test/release-channel.test.mjs",
    "test:maintenance-worker": "node --test scripts/test/maintenance-worker.test.mjs",
    "test:channel-builds": "node scripts/test-channel-builds.mjs",
    "preview": "pnpm --filter @alpha-kanban/web preview",
    "typecheck": "pnpm --filter @alpha-kanban/web typecheck",
    "install:skill": "node scripts/install-implementation-ledger-skill.mjs",
    "ticket-md": "node scripts/ticket-md.mjs",
    "document-cli": "node scripts/document-cli.mjs",
    "test:ledger": "node --test scripts/test/document-context.test.mjs scripts/test/document-owner.test.mjs",
    "build:document-cli": "node scripts/build-document-cli.mjs",
    "test:skill-distribution": "node --test --test-concurrency=1 scripts/test/skill-distribution.test.mjs",
    "test:documents": "node --test --test-concurrency=1 scripts/test/document-plan.test.mjs scripts/test/document-scan.test.mjs scripts/test/document-journal.test.mjs scripts/test/document-transaction.test.mjs scripts/test/document-cli.test.mjs scripts/test/document-migration.test.mjs scripts/test/document-root.test.mjs",
    "test": "pnpm test:channels && pnpm test:ledger && pnpm test:documents && pnpm test:maintenance-worker && pnpm test:skill-distribution && pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "0.28.2",
    "fflate": "^0.8.3",
    "playwright": "1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
